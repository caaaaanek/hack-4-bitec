# Для локального запуску без Docker. Скопіюйте у backend/.env
DATABASE_URL=postgresql+psycopg://imd:imd@localhost:5432/imd
JWT_SECRET=
DEMO_PASSWORD=
# Ключ для інших систем, що передають факти (POST /indicators, заголовок X-Integration-Key)
INTEGRATION_API_KEY=
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
