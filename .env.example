# Скопіюйте у .env і заповніть. Файл .env не комітиться.
POSTGRES_PASSWORD=
# Будь-який довгий випадковий рядок: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
# Пароль синтетичних демо-користувачів (мінімум 8 символів)
DEMO_PASSWORD=
# Ключ для інших систем, що передають факти (POST /indicators, заголовок X-Integration-Key)
INTEGRATION_API_KEY=
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
